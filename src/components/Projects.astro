---
/**
 * Section wrapper only. The cards are composed in index.astro so each can be
 * handed its own expanded content as a slot — a `.map()` over the data cannot
 * pass different children per project.
 *
 * Cards stack in a single column rather than a grid. An expanded card holds a
 * full dashboard, and a dashboard squeezed into a half-width grid cell reads
 * badly at every breakpoint that matters.
 */
---

<section class="section" id="projects">
  <div class="container">
    <p class="section__label">Nights &amp; weekends</p>
    <h2 class="section__title">Projects</h2>
    <p class="section__intro">
      Things I build outside work to stay sharp on the tools. Each one ships end to end — data in,
      decision out — rather than stopping at a notebook. Open a card for the full analysis.
    </p>

    <div class="cards">
      <slot />
    </div>
  </div>
</section>

<script>
  /**
   * Open the card a link points at.
   *
   * Browsers auto-expand a <details> to reveal a fragment target *inside* it,
   * but not when the id is on the element itself — which it must be here, since
   * the card is the thing worth linking to. Eleven lines buys a shareable
   * https://gregchedwick.dev/#carrier-survival that lands open rather than
   * collapsed.
   */
  const openTarget = () => {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    const card = document.getElementById(id);
    if (card instanceof HTMLDetailsElement && !card.open) {
      card.open = true;
      card.scrollIntoView({ block: 'start' });
    }
  };

  openTarget();
  window.addEventListener('hashchange', openTarget);
</script>

<style>
  .cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }
</style>
