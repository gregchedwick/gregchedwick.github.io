---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpeg';
import { profile } from '../data/resume';
---

<section class="hero" id="top">
  <div class="container hero__inner">
    <div class="hero__body">
      <p class="hero__eyebrow">
        <span class="hero__pulse" aria-hidden="true"></span>
        {profile.title} at {profile.company} · {profile.location}
      </p>

      <h1 class="hero__name">{profile.name}</h1>

      <p class="hero__tagline">{profile.tagline}</p>

      <p class="hero__summary">{profile.summary}</p>

      <div class="hero__actions">
        <a class="btn btn--primary" href="#projects">See the work</a>
        <a class="btn" href="#experience">Career history</a>
      </div>

      <ul class="hero__links">
        <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
        <li><a href={profile.linkedin}>LinkedIn</a></li>
        <li><a href={profile.github}>GitHub</a></li>
      </ul>
    </div>

    <div class="hero__portrait">
      {/*
        `width` pins the plain `src` fallback to 640px. Without it Astro points
        src at the 3000px original — a 728kB download for a 20rem slot.
      */}
      <Image
        src={portrait}
        alt={`Portrait of ${profile.name}`}
        width={640}
        widths={[320, 480, 640]}
        sizes="(min-width: 60rem) 20rem, (min-width: 40rem) 16rem, 12rem"
        format="webp"
        quality={82}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .hero__inner {
    display: flex;
    flex-direction: column-reverse;
    align-items: flex-start;
    gap: var(--space-xl);
  }

  .hero__body { flex: 1 1 30rem; min-width: 0; }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-secondary);
    background: var(--accent-wash);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 0.3rem var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .hero__pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent);
    animation: pulse 2.4s ease-out infinite;
  }

  @keyframes pulse {
    0%   { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 55%, transparent); }
    70%  { box-shadow: 0 0 0 7px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  .hero__name {
    font-size: var(--step-4);
    font-weight: 700;
    margin-bottom: var(--space-sm);
  }

  .hero__tagline {
    font-size: var(--step-1);
    color: var(--ink);
    max-width: 34ch;
    margin-bottom: var(--space-md);
    font-weight: 500;
  }

  .hero__summary {
    color: var(--ink-secondary);
    max-width: var(--measure);
    margin-bottom: var(--space-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem var(--space-md);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--ink);
    font-size: var(--step--1);
    font-weight: 550;
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .btn:hover {
    background: var(--accent-wash);
    border-color: var(--accent);
    color: var(--ink);
  }

  .btn--primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .btn--primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    color: #fff;
  }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--step--1);
  }
  .hero__links a {
    color: var(--ink-secondary);
    text-decoration: none;
    border-bottom: 1px solid var(--border-strong);
    padding-bottom: 1px;
  }
  .hero__links a:hover { color: var(--accent); border-color: var(--accent); }

  .hero__portrait {
    flex: 0 0 auto;
    width: clamp(9rem, 34vw, 12rem);
  }

  .hero__portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 50% 22%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    filter: saturate(0.96);
  }

  @media (min-width: 60rem) {
    .hero { padding-block: var(--space-3xl) var(--space-xl); }
    .hero__inner {
      flex-direction: row;
      align-items: center;
      gap: var(--space-2xl);
    }
    .hero__portrait { width: 20rem; }
    .hero__portrait :global(img) { aspect-ratio: 4 / 5; }
  }
</style>
