---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpeg';
import { profile } from '../data/resume';
---

<section class="hero" id="top">
  <div class="container hero__inner">
    <div class="hero__body">
      <p class="hero__eyebrow">
        <span class="hero__pulse" aria-hidden="true"></span>
        {profile.title} at {profile.company} · {profile.location}
      </p>

      <h1 class="hero__name">{profile.name}</h1>

      <p class="hero__tagline">{profile.tagline}</p>

      <p class="hero__summary">{profile.summary}</p>

      <div class="hero__actions">
        {/*
          Leads the row. On an analytics portfolio the repositories are the
          evidence — a recruiter checking whether the claims hold up goes here
          first, so this carries the primary weight rather than a section jump.
        */}
        <a class="btn btn--primary" href={profile.github}>
          <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
            <path
              fill="currentColor"
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
            />
          </svg>
          GitHub
        </a>
        <a class="btn" href="#projects">See the work</a>
        <a class="btn" href="#experience">Career history</a>
        {/* Built by scripts/build_resume_pdf.py — a redacted copy of the master. */}
        <a class="btn btn--quiet" href="/resume.pdf" download="Greg Chedwick - Resume.pdf">
          <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
            <path
              d="M12 3v12m0 0 4.5-4.5M12 15l-4.5-4.5M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"
              fill="none"
              stroke="currentColor"
              stroke-width="1.9"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          Résumé
        </a>
      </div>

      <ul class="hero__links">
        <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
        <li><a href={profile.linkedin}>LinkedIn</a></li>
      </ul>
    </div>

    <div class="hero__portrait">
      {/*
        portrait.jpeg is a 4:5 crop of Pictures/Greg.jpg, produced by
        scripts/prepare_portrait.py — adjust the crop box there, not here. The
        aspect must stay 4:5 to match the frame below.

        `width` pins the plain `src` fallback to 640px. Without it Astro points
        src at the full-size original — a needless download for a 20rem slot.
      */}
      <Image
        src={portrait}
        alt={`Portrait of ${profile.name}`}
        width={640}
        widths={[320, 480, 640]}
        sizes="(min-width: 60rem) 20rem, (min-width: 40rem) 16rem, 12rem"
        format="webp"
        quality={82}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .hero__inner {
    display: flex;
    flex-direction: column-reverse;
    align-items: flex-start;
    gap: var(--space-xl);
  }

  .hero__body { flex: 1 1 30rem; min-width: 0; }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-secondary);
    background: var(--accent-wash);
    border: 1px solid var(--border);
    border-radius: 100px;
    padding: 0.3rem var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .hero__pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent);
    animation: pulse 2.4s ease-out infinite;
  }

  @keyframes pulse {
    0%   { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 55%, transparent); }
    70%  { box-shadow: 0 0 0 7px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }

  .hero__name {
    font-size: var(--step-4);
    font-weight: 700;
    margin-bottom: var(--space-sm);
  }

  /* 97 characters. At 34ch it broke to three lines and left the column half
     empty beside the portrait; ~52ch lands it on two. */
  .hero__tagline {
    font-size: var(--step-1);
    color: var(--ink);
    max-width: 52ch;
    margin-bottom: var(--space-md);
    font-weight: 500;
  }

  /* 548 characters. The usual --measure (68ch) ran it to seven lines and left
     the same dead space. ~108ch brings it to five.
     Deliberately past the comfortable reading measure: this is three sentences
     read once at the top of a page, not body copy, and the alternative is a
     column of text with an empty half beside it. Everything below the hero is
     still held to --measure. */
  .hero__summary {
    color: var(--ink-secondary);
    max-width: 108ch;
    margin-bottom: var(--space-lg);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    padding: 0.6rem var(--space-md);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--ink);
    font-size: var(--step--1);
    font-weight: 550;
    text-decoration: none;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .btn:hover {
    background: var(--accent-wash);
    border-color: var(--accent);
    color: var(--ink);
  }

  .btn--primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }
  .btn--primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    color: #fff;
  }

  /* Third in a row of three — present without competing with the other two. */
  .btn--quiet {
    gap: var(--space-2xs);
    border-color: var(--border);
    color: var(--ink-secondary);
  }
  .btn--quiet:hover { color: var(--ink); }

  .hero__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--step--1);
  }
  .hero__links a {
    color: var(--ink-secondary);
    text-decoration: none;
    border-bottom: 1px solid var(--border-strong);
    padding-bottom: 1px;
  }
  .hero__links a:hover { color: var(--accent); border-color: var(--accent); }

  .hero__portrait {
    flex: 0 0 auto;
    width: clamp(9rem, 34vw, 12rem);
  }

  /* 4:5 at every width — the asset is already cropped to 4:5, so nothing is
     cut here. A square frame would slice off his chin. */
  .hero__portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    filter: saturate(0.96);
  }

  @media (min-width: 60rem) {
    .hero { padding-block: var(--space-3xl) var(--space-xl); }
    .hero__inner {
      flex-direction: row;
      align-items: center;
      gap: var(--space-xl);
    }

    /* Capped rather than growing to fill. The text stops where it stops, and
       the portrait centres itself in whatever is left instead of being pushed
       flush against the right edge with a gap in the middle. */
    .hero__body { flex: 0 1 56rem; }

    /* One governing width above this breakpoint. Two competing caps — the
       column and the text measure — made the line count depend on whichever
       happened to be smaller, which is a fiddly thing to reason about; the
       56rem column is now the only constraint, landing the summary on five
       lines and the tagline on two. Below 60rem --measure still applies. */
    .hero__summary { max-width: none; }

    .hero__portrait {
      flex: 1 1 auto;
      width: auto;
      display: flex;
      justify-content: center;
    }

    /* The frame is fixed here because the container is now flexible — at
       width: 100% the portrait would stretch to fill the leftover space. */
    .hero__portrait :global(img) {
      width: min(20rem, 100%);
    }
  }
</style>
