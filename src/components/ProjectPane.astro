---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;

/**
 * The pane carries only what the card does not.
 *
 * Title, blurb and highlights all live on the card that selects this pane, and
 * the card sits directly above it — repeating them pushed the real content down
 * and made every pane read as if it started over. What is left is the role line
 * (which appears nowhere else) and the detail itself.
 *
 * The pane is labelled by its tab, so it needs no heading of its own for
 * assistive technology either.
 */
---

<div
  class="pane"
  role="tabpanel"
  id={`pane-${project.slug}`}
  aria-labelledby={`tab-${project.slug}`}
  data-slug={project.slug}
  tabindex="0"
>
  <p class="pane__role">{project.role}</p>

  <slot />

  {
    project.repo && (
      <a class="pane__repo" href={project.repo}>
        Repository ↗
      </a>
    )
  }
</div>

<style>
  .pane__role {
    margin: 0 0 var(--space-lg);
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    color: var(--ink-muted);
  }

  .pane__repo {
    display: inline-block;
    margin-top: var(--space-lg);
    font-weight: 600;
    font-size: var(--step--1);
    color: var(--accent);
  }

  .pane__repo:hover {
    color: var(--accent-hover);
  }

  /* Focus lands here after a tab is chosen; the ring would otherwise draw a box
     round a whole dashboard. */
  .pane:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
    border-radius: var(--radius);
  }
</style>
