---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  /** True when the card has expandable detail. Without it the card is static. */
  expandable?: boolean;
  /**
   * Render this card already open. Exactly one should be, and it should be the
   * strongest work: a visitor landing on three collapsed headers sees none of
   * the charts, and the charts are the argument. The accordion still bounds the
   * page — opening another closes this one.
   */
  open?: boolean;
}

const { project, expandable = false, open = false } = Astro.props;

/**
 * Cards use a native `<details>` with a shared `name`, which makes the group an
 * accordion in the browser itself — opening one closes the rest, with no
 * JavaScript and full keyboard support inherited for free.
 *
 * The point is a page whose length does not grow with the portfolio. Each new
 * project used to append a full dashboard to the scroll; now it appends one
 * collapsed header.
 *
 * Where `name` is unsupported the cards simply toggle independently, which is
 * the graceful outcome rather than a broken one.
 */
const hasDetail = expandable && Astro.slots.has('default');
---

{
  hasDetail ? (
    <details class="card card--expandable" name="projects" id={project.slug} open={open}>
      <summary class="card__summary">
        <div class="card__head">
          <h3 class="card__title">{project.title}</h3>
          <span class="card__status" data-status={project.status}>
            {project.status === 'live' ? 'Shipped' : 'In progress'}
          </span>
        </div>

        <p class="card__blurb">{project.blurb}</p>

        <ul class="card__highlights">
          {project.highlights.map((point) => (
            <li>{point}</li>
          ))}
        </ul>

        <ul class="card__stack">
          {project.stack.map((tech) => (
            <li>{tech}</li>
          ))}
        </ul>

        <span class="card__cue">
          <span class="card__cue-open">Explore the data</span>
          <span class="card__cue-close">Collapse</span>
          <svg class="card__chevron" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path
              d="M4 6l4 4 4-4"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </span>
      </summary>

      <div class="card__detail">
        <slot />

        {project.repo && (
          <a class="card__link card__link--primary" href={project.repo}>
            Repository ↗
          </a>
        )}
      </div>
    </details>
  ) : (
    <article class="card" id={project.slug}>
      <div class="card__head">
        <h3 class="card__title">{project.title}</h3>
        <span class="card__status" data-status={project.status}>
          {project.status === 'live' ? 'Shipped' : 'In progress'}
        </span>
      </div>

      <p class="card__blurb">{project.blurb}</p>

      <ul class="card__highlights">
        {project.highlights.map((point) => (
          <li>{point}</li>
        ))}
      </ul>

      <ul class="card__stack">
        {project.stack.map((tech) => (
          <li>{tech}</li>
        ))}
      </ul>

      {project.repo && (
        <footer class="card__foot">
          <a class="card__link" href={project.repo}>
            Repository ↗
          </a>
        </footer>
      )}
    </article>
  )
}

<style>
  .card {
    display: flex;
    flex-direction: column;
    padding: var(--space-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.15s ease;
  }

  .card:hover {
    border-color: var(--border-strong);
  }

  /* `display: flex` on a <details> suppresses the disclosure in some engines,
     so the expandable variant stays block-level and lets the summary lay out. */
  .card--expandable {
    display: block;
    padding: 0;
  }

  .card--expandable[open] {
    border-color: var(--border-strong);
  }

  .card__summary {
    display: block;
    padding: var(--space-lg);
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius);
  }

  /* Safari renders its own triangle unless this pseudo-element is cleared. */
  .card__summary::-webkit-details-marker {
    display: none;
  }

  .card__summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
  }

  .card__title {
    font-size: var(--step-1);
    font-weight: 620;
    margin: 0;
  }

  .card__status {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: 100px;
    border: 1px solid var(--border);
    color: var(--ink-muted);
  }

  .card__status[data-status='live'] {
    color: var(--success);
    border-color: color-mix(in srgb, var(--success) 35%, transparent);
  }

  .card__blurb {
    color: var(--ink-secondary);
    margin: 0 0 var(--space-md);
    text-wrap: pretty;
  }

  .card__highlights {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    font-size: var(--step--1);
    color: var(--ink-secondary);
  }

  .card__highlights li {
    position: relative;
    padding-left: var(--space-md);
    line-height: 1.5;
  }

  .card__highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0.55;
  }

  .card__stack {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-md);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
  }

  .card__stack li {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.18rem 0.45rem;
    border-radius: var(--radius-sm);
    background: var(--gridline);
    color: var(--ink-secondary);
  }

  /* ---------- disclosure affordance ---------- */
  .card__cue {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-size: var(--step--1);
    font-weight: 550;
    color: var(--accent);
  }

  .card__summary:hover .card__cue {
    color: var(--accent-hover);
  }

  .card--expandable[open] .card__cue-open,
  .card__cue-close {
    display: none;
  }

  .card--expandable[open] .card__cue-close {
    display: inline;
  }

  .card__chevron {
    width: 0.9em;
    height: 0.9em;
    transition: transform 0.18s ease;
  }

  .card--expandable[open] .card__chevron {
    transform: rotate(180deg);
  }

  /* ---------- expanded body ---------- */
  .card__detail {
    padding: 0 var(--space-lg) var(--space-lg);
    border-top: 1px solid var(--border);
    margin-top: 0;
    padding-top: var(--space-lg);
  }

  .card__foot {
    margin-top: auto;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    font-size: var(--step--1);
  }

  .card__link {
    display: inline-block;
    margin-top: var(--space-md);
    text-decoration: none;
    color: var(--ink-secondary);
    font-weight: 550;
    font-size: var(--step--1);
  }

  .card__link:hover {
    color: var(--accent);
  }

  .card__link--primary {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card__chevron {
      transition: none;
    }
  }
</style>
