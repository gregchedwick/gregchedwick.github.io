---
import { profile } from '../data/resume';

const links = [
  { label: 'Email', value: profile.email, href: `mailto:${profile.email}` },
  { label: 'LinkedIn', value: 'in/gregchedwick', href: profile.linkedin },
  { label: 'GitHub', value: '@gregchedwick', href: profile.github },
];
---

<section class="section contact" id="contact">
  <div class="container contact__inner">
    <div>
      <p class="section__label">Get in touch</p>
      <h2 class="section__title">Open to analytics leadership roles</h2>
      <p class="contact__blurb">
        Based in {profile.location}, working remotely across time zones. If you are building
        something in the 0-to-1 space and need someone to make the data legible, I would like to
        hear about it.
      </p>
    </div>

    <ul class="contact__links">
      {
        links.map((link) => (
          <li>
            <a class="contact__link" href={link.href}>
              <span class="contact__label">{link.label}</span>
              <span class="contact__value">{link.value}</span>
              <span class="contact__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contact__inner {
    display: grid;
    gap: var(--space-xl);
  }

  @media (min-width: 52rem) {
    .contact__inner {
      grid-template-columns: 1fr minmax(18rem, 22rem);
      align-items: start;
      gap: var(--space-2xl);
    }
  }

  .contact__blurb {
    color: var(--ink-secondary);
    max-width: var(--measure);
  }

  .contact__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .contact__link {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-2xs) var(--space-sm);
    padding: var(--space-md);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--ink);
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .contact__link:hover {
    border-color: var(--accent);
    background: var(--accent-wash);
    color: var(--ink);
  }

  .contact__label {
    grid-column: 1;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .contact__value {
    grid-column: 1;
    font-size: var(--step--1);
    font-weight: 550;
    overflow-wrap: anywhere;
  }

  .contact__arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
    color: var(--ink-muted);
    transition: transform 0.15s ease, color 0.15s ease;
  }
  .contact__link:hover .contact__arrow {
    color: var(--accent);
    transform: translateX(3px);
  }
</style>
