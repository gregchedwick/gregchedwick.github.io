---
import data from '../data/netflix-ads.json';

const { titles, genres, weights, titleCount, genreCoverage, generated } = data;

const fmtHours = (n: number) =>
  n >= 1_000_000_000 ? `${(n / 1_000_000_000).toFixed(1)}B` : `${Math.round(n / 1_000_000)}M`;

// Every figure on screen is grouped — an unseparated 991500000 is unreadable.
const fmtInt = (n: number) => Math.round(n).toLocaleString('en-US');
const fmtDec = (n: number, digits = 1) =>
  n.toLocaleString('en-US', { minimumFractionDigits: digits, maximumFractionDigits: digits });

/**
 * Where a bar chart's axis should end.
 *
 * KPop Demon Hunters scores about four times the runner-up on every measure,
 * so scaling to it leaves one full bar and eleven stubs — the genre panel reads
 * far better only because averaging compresses its range. When one value
 * dominates, the axis stops just above the runner-up and the single bar that
 * overruns is drawn as clipped. Every other bar keeps a true zero-baseline
 * proportion, and the exact figure sits beside each one regardless.
 */
function axisMax(values: number[]) {
  const max = Math.max(...values);
  const [, second] = [...values].sort((a, b) => b - a);
  return second && max > second * 1.8 ? second * 1.12 : max;
}

// Titles are pre-sorted by score; the client re-sorts from this same list.
const initial = titles.slice(0, 12);
const titleAxis = axisMax(initial.map((t) => t.score));
const topGenres = genres.slice(0, 8);
const genreAxis = axisMax(topGenres.map((g) => g.avgScore));

const seriesVar = ['--series-1', '--series-2', '--series-3', '--series-4'];
---

<section class="section netflix" id="netflix">
  <div class="container">
    <p class="section__label">Live project data</p>
    <h2 class="section__title">Netflix Ad Opportunity Score</h2>
    <p class="section__intro">
      Which titles are worth buying ad inventory against? I scored all {titleCount} titles in the
      2025–26 global top 500 by blending how much they were actually watched with how long they
      stayed relevant. These charts run on the real output of that analysis — not screenshots.
    </p>

    <!--
      Two columns: the tall titles chart on the left, and the filters stacked
      above genres and the weighting model on the right. DOM order puts the
      filters first so they are reached before the charts they drive.
    -->
    <div class="dashboard">
      <div class="controls">
        <fieldset class="control">
          <legend class="control__label">Rank by</legend>
          <div class="segmented" role="group">
            <button type="button" data-sort="score" aria-pressed="true">Opportunity score</button>
            <button type="button" data-sort="hoursViewed" aria-pressed="false">Hours viewed</button>
            <button type="button" data-sort="weeksInTop10" aria-pressed="false">Weeks in top 10</button>
          </div>
        </fieldset>

        <label class="control control--count">
          <span class="control__label">Show top</span>
          <select data-count>
            <option value="8">8</option>
            <option value="12" selected>12</option>
            <option value="20">20</option>
            <option value="30">30</option>
          </select>
        </label>

        <p class="controls__note">Both charts respond to these.</p>
      </div>

      <!-- ---------- titles ---------- -->
      <figure class="panel panel--titles">
        <figcaption class="panel__head">
          <h3 class="panel__title" data-title-heading>Top Titles by Opportunity Score</h3>
          <p class="panel__note" data-title-note>
            Score blends hours viewed, sustained ranking, rating, and recency.
          </p>
        </figcaption>

        <ol class="bars" data-titles>
          {
            initial.map((t) => (
              <li class="bar-row">
                <span class="bar-row__head">
                  <span class="bar-row__title" title={t.title}>{t.title}</span>
                  <span class="bar-row__value">- {fmtInt(t.score)}</span>
                </span>
                <span class="bar-row__track">
                  <span
                    class="bar-row__bar"
                    data-clipped={t.score > titleAxis ? 'true' : 'false'}
                    style={`--pct:${Math.min(100, (t.score / titleAxis) * 100)}%`}
                  />
                </span>
                <span class="bar-row__meta">
                  {t.year} · {fmtInt(t.weeksInTop10)} wks · {fmtHours(t.hoursViewed)} hrs
                </span>
              </li>
            ))
          }
        </ol>

        <p class="panel__foot">
          Hover or focus a bar for the underlying numbers. A bar that fades at its end runs past
          the axis — the axis stops above the runner-up so the rest stay comparable.
        </p>
      </figure>

      <!-- ---------- genres ---------- -->
      <figure class="panel panel--genres">
        <figcaption class="panel__head">
          <h3 class="panel__title" data-genre-heading>Genres by Average Score</h3>
          <p class="panel__note" data-genre-note>
            Averaged across every ranked title carrying that genre. Title counts vary — War is a
            small, high-performing set.
          </p>
        </figcaption>

        <ol class="bars bars--genre" data-genres>
          {
            topGenres.map((g) => (
              <li class="bar-row">
                <span class="bar-row__head">
                  <span class="bar-row__title">{g.genre}</span>
                  <span class="bar-row__value">- {fmtDec(g.avgScore)}</span>
                </span>
                <span class="bar-row__track">
                  <span
                    class="bar-row__bar"
                    data-clipped={g.avgScore > genreAxis ? 'true' : 'false'}
                    style={`--pct:${Math.min(100, (g.avgScore / genreAxis) * 100)}%`}
                  />
                </span>
                <span class="bar-row__meta">
                  {fmtInt(g.titleCount)} titles · {fmtHours(g.totalHours)} hrs
                </span>
              </li>
            ))
          }
        </ol>
      </figure>

      <!-- ---------- scoring model ---------- -->
      <figure class="panel panel--weights">
        <figcaption class="panel__head">
          <h3 class="panel__title">How the Score Is Weighted</h3>
          <p class="panel__note">
            Hours viewed dominates deliberately — it is the closest available proxy for realised ad
            impressions. The rest adjust for staying power and quality.
          </p>
        </figcaption>

        <!-- Proportion bar. Every segment is direct-labelled below: two of these
             hues sit under 3:1 on the light surface, so labels are required relief,
             not decoration. -->
        <div class="weights" role="img" aria-label={
          weights.map((w) => `${w.component} ${w.weight} percent`).join(', ')
        }>
          {
            weights.map((w, i) => (
              <span
                class="weights__segment"
                style={`--pct:${w.weight}%; --fill:var(${seriesVar[i % seriesVar.length]})`}
              />
            ))
          }
        </div>

        <ul class="weights__key">
          {
            weights.map((w, i) => (
              <li class="weights__item">
                <span
                  class="weights__swatch"
                  style={`--fill:var(${seriesVar[i % seriesVar.length]})`}
                  aria-hidden="true"
                />
                <span class="weights__name">{w.component}</span>
                <span class="weights__pct">{w.weight}%</span>
                <span class="weights__why">{w.rationale}</span>
              </li>
            ))
          }
        </ul>
      </figure>
    </div>

    <details class="caveat">
      <summary>Data notes and known limits</summary>
      <div class="caveat__body">
        <p>
          Genre coverage is partial: only {genreCoverage.tagged} of the top {genreCoverage.total}
          titles carry genre metadata, because most 2025–26 chart-toppers are newer than the
          catalogue they join against. That is why there is no genre filter on the titles chart —
          it would silently hide two-thirds of the data. The genre panel aggregates across all
          {titleCount} ranked titles, where coverage is high enough to average meaningfully.
        </p>
        <p>
          <em>KPop Demon Hunters</em> is a genuine outlier at roughly four times the second-place
          score, which compresses everything below it. It is left in rather than trimmed, because
          the whole point of the metric is to surface exactly that kind of title.
        </p>
        <p>Data generated {generated} from the project's processed output.</p>
      </div>
    </details>

    <p class="netflix__links">
      <a href="https://github.com/gregchedwick/Netflix-Ads-Analytics">Repository</a>
      <span aria-hidden="true">·</span>
      <a href="https://github.com/gregchedwick/Netflix-Ads-Analytics/blob/main/Notebooks/01_data_exploration.ipynb">
        Analysis notebook
      </a>
      <span aria-hidden="true">·</span>
      <a href="https://github.com/gregchedwick/Netflix-Ads-Analytics/tree/main/Reports">
        Power BI report
      </a>
    </p>
  </div>

  <!--
    Single tooltip, repositioned on hover/focus. Both children are rendered here
    rather than created in JS, so Astro's scoped styles actually reach them.
  -->
  <div class="tip" data-tip hidden role="status" aria-live="polite">
    <strong class="tip__head" data-tip-head></strong>
    <span class="tip__body" data-tip-body></span>
  </div>
</section>

<script>
  import titleData from '../data/netflix-ads.json';

  type Title = (typeof titleData.titles)[number];
  type Genre = (typeof titleData.genres)[number];

  const list = document.querySelector<HTMLOListElement>('[data-titles]');
  const heading = document.querySelector<HTMLElement>('[data-title-heading]');
  const note = document.querySelector<HTMLElement>('[data-title-note]');
  const genreList = document.querySelector<HTMLOListElement>('[data-genres]');
  const genreHeading = document.querySelector<HTMLElement>('[data-genre-heading]');
  const genreNote = document.querySelector<HTMLElement>('[data-genre-note]');
  const countSelect = document.querySelector<HTMLSelectElement>('[data-count]');
  const sortButtons = document.querySelectorAll<HTMLButtonElement>('[data-sort]');
  const tip = document.querySelector<HTMLElement>('[data-tip]');

  if (list && tip) {
    const fmtInt = (n: number) => Math.round(n).toLocaleString('en-US');
    const fmtDec = (n: number, digits = 1) =>
      n.toLocaleString('en-US', { minimumFractionDigits: digits, maximumFractionDigits: digits });
    // Compact form, for the sub-line only — the tooltip keeps the full figure.
    const fmtHours = (n: number) =>
      n >= 1_000_000_000 ? `${(n / 1_000_000_000).toFixed(1)}B` : `${Math.round(n / 1_000_000)}M`;

    const SORTS = {
      score: {
        key: 'score' as const,
        heading: 'Top Titles by Opportunity Score',
        note: 'Score blends hours viewed, sustained ranking, rating, and recency.',
        format: (t: Title) => fmtInt(t.score),
      },
      hoursViewed: {
        key: 'hoursViewed' as const,
        heading: 'Top Titles by Hours Viewed',
        note: 'Raw consumption — the single largest input to the score, shown on its own.',
        format: (t: Title) => fmtInt(t.hoursViewed),
      },
      weeksInTop10: {
        key: 'weeksInTop10' as const,
        heading: 'Top Titles by Weeks in the Top 10',
        note: 'Staying power. Note how differently this ranks from raw hours — that gap is why the score exists.',
        format: (t: Title) => fmtInt(t.weeksInTop10),
      },
    };

    /*
     * The genre panel answers the same three questions at genre level. Hours are
     * a total — the size of the inventory a genre represents — while score and
     * weeks are averages, since a genre with 81 titles would otherwise win those
     * on volume alone.
     */
    const GENRE_SORTS = {
      score: {
        key: 'avgScore' as const,
        heading: 'Genres by Average Score',
        note: 'Averaged across every ranked title carrying that genre. Title counts vary — War is a small, high-performing set.',
        format: (g: Genre) => fmtDec(g.avgScore),
      },
      hoursViewed: {
        key: 'totalHours' as const,
        heading: 'Genres by Total Hours Viewed',
        note: 'Total rather than average — this is the size of the ad inventory each genre represents, so the broad genres rightly dominate.',
        format: (g: Genre) => fmtInt(g.totalHours),
      },
      weeksInTop10: {
        key: 'avgWeeks' as const,
        heading: 'Genres by Average Weeks in Top 10',
        note: 'How long a typical title in the genre holds its place. A different ordering again from either score or raw hours.',
        format: (g: Genre) => fmtDec(g.avgWeeks),
      },
    };

    let sort: keyof typeof SORTS = 'score';
    let count = 12;

    /*
     * Rows are cloned from a server-rendered one, never built with
     * document.createElement.
     *
     * Astro scopes component CSS by appending an attribute to every selector
     * (.bar-row__track[data-astro-cid-…]). Elements created in JS do not carry
     * that attribute, so none of the panel's CSS applied to them: the track had
     * no height and the bar no width, which is why this chart showed labels but
     * no bars while the server-rendered genre panel looked correct. Cloning a
     * real row copies the attribute along with the structure.
     */
    const prototype = list.querySelector<HTMLLIElement>('.bar-row')?.cloneNode(true) as
      | HTMLLIElement
      | undefined;
    const genrePrototype = genreList?.querySelector<HTMLLIElement>('.bar-row')?.cloneNode(true) as
      | HTMLLIElement
      | undefined;

    /** Where a bar chart's axis should end — see the note in the frontmatter. */
    const axisFor = (values: number[]) => {
      const highest = Math.max(...values);
      const [, second] = [...values].sort((a, b) => b - a);
      return second && highest > second * 1.8 ? second * 1.12 : highest;
    };

    const renderGenres = () => {
      if (!genreList || !genrePrototype) return;
      const config = GENRE_SORTS[sort];
      const rows = [...titleData.genres]
        .sort((a, b) => (b[config.key] as number) - (a[config.key] as number))
        .slice(0, Math.min(count, titleData.genres.length));

      const axis = axisFor(rows.map((r) => r[config.key] as number));

      if (genreHeading) genreHeading.textContent = config.heading;
      if (genreNote) genreNote.textContent = config.note;

      genreList.replaceChildren(
        ...rows.map((g) => {
          const li = genrePrototype.cloneNode(true) as HTMLLIElement;

          const title = li.querySelector<HTMLElement>('.bar-row__title');
          if (title) title.textContent = g.genre;

          const value = li.querySelector<HTMLElement>('.bar-row__value');
          if (value) value.textContent = `- ${config.format(g)}`;

          const magnitude = g[config.key] as number;
          const bar = li.querySelector<HTMLElement>('.bar-row__bar');
          if (bar) {
            bar.dataset.clipped = magnitude > axis ? 'true' : 'false';
            bar.style.setProperty('--pct', `${Math.min(100, (magnitude / axis) * 100)}%`);
          }

          const meta = li.querySelector<HTMLElement>('.bar-row__meta');
          if (meta) {
            meta.textContent = [
              `${fmtInt(g.titleCount)} titles`,
              `${fmtHours(g.totalHours)} hrs`,
              `${fmtDec(g.avgWeeks)} wks avg`,
            ].join(' · ');
          }

          return li;
        }),
      );
    };

    const render = () => {
      if (!prototype) return;
      const config = SORTS[sort];
      const rows = [...titleData.titles]
        .sort((a, b) => (b[config.key] as number) - (a[config.key] as number))
        .slice(0, count);

      // Recomputed per sort — every measure has the same dominant title, so the
      // cap applies across all three filters, not just the default one.
      const axis = axisFor(rows.map((r) => r[config.key] as number));

      if (heading) heading.textContent = config.heading;
      if (note) note.textContent = config.note;

      list.replaceChildren(
        ...rows.map((t) => {
          const li = prototype.cloneNode(true) as HTMLLIElement;
          li.tabIndex = 0;
          // Header repeats the ranked value so the tooltip matches the bar the
          // pointer is on, whichever sort is active. Every metric line is
          // "Label - Value" and stays on one line; the CSS does not wrap them.
          li.dataset.tipHead = `${t.title} - ${config.format(t)}`;
          li.dataset.tip = [
            `Opportunity Score - ${fmtDec(t.score)}`,
            `Hours Viewed - ${fmtInt(t.hoursViewed)}`,
            `Weeks in Top 10 - ${fmtInt(t.weeksInTop10)}`,
            t.voteAverage ? `Rating - ${fmtDec(t.voteAverage)} / 10` : null,
            t.runtime ? `Runtime - ${fmtInt(t.runtime)} min` : null,
            // A year is an identifier, not a quantity — never group it as 2,025.
            t.year ? `Released - ${t.year}` : null,
          ]
            .filter(Boolean)
            .join('\n');

          const title = li.querySelector<HTMLElement>('.bar-row__title');
          if (title) {
            title.textContent = t.title;
            title.title = t.title;
          }

          const value = li.querySelector<HTMLElement>('.bar-row__value');
          if (value) value.textContent = `- ${config.format(t)}`;

          const magnitude = t[config.key] as number;
          const bar = li.querySelector<HTMLElement>('.bar-row__bar');
          if (bar) {
            bar.dataset.clipped = magnitude > axis ? 'true' : 'false';
            bar.style.setProperty('--pct', `${Math.min(100, (magnitude / axis) * 100)}%`);
          }

          // Mirrors the genre panel's sub-line, and carries the two measures
          // that are not currently driving the ranking.
          const meta = li.querySelector<HTMLElement>('.bar-row__meta');
          if (meta) {
            meta.textContent = [
              t.year,
              `${fmtInt(t.weeksInTop10)} wks`,
              `${fmtHours(t.hoursViewed)} hrs`,
            ].join(' · ');
          }

          return li;
        }),
      );
    };

    // --- tooltip ---

    const tipHead = tip.querySelector<HTMLElement>('[data-tip-head]');
    const tipBody = tip.querySelector<HTMLElement>('[data-tip-body]');

    const showTip = (row: HTMLElement) => {
      const text = row.dataset.tip;
      if (!text) return;

      if (tipHead) tipHead.textContent = row.dataset.tipHead ?? '';
      if (tipBody) tipBody.textContent = text;
      tip.hidden = false;

      const rect = row.getBoundingClientRect();
      const tipRect = tip.getBoundingClientRect();
      const gap = 10;

      // Prefer above the row; flip below when there isn't room.
      const above = rect.top - tipRect.height - gap;
      const top = above > 8 ? above : rect.bottom + gap;

      // Clamp horizontally so the tip never pushes the page sideways.
      const left = Math.min(
        Math.max(gap, rect.left + rect.width / 2 - tipRect.width / 2),
        window.innerWidth - tipRect.width - gap,
      );

      tip.style.transform = `translate(${left}px, ${top}px)`;
    };

    const hideTip = () => {
      tip.hidden = true;
    };

    list.addEventListener('pointerover', (event) => {
      const row = (event.target as HTMLElement).closest<HTMLElement>('.bar-row');
      if (row) showTip(row);
    });
    list.addEventListener('pointerleave', hideTip);
    list.addEventListener('focusin', (event) => {
      const row = (event.target as HTMLElement).closest<HTMLElement>('.bar-row');
      if (row) showTip(row);
    });
    list.addEventListener('focusout', hideTip);
    window.addEventListener('scroll', hideTip, { passive: true });

    // --- controls ---

    // Both charts redraw together — the filters govern the whole dashboard.
    const renderAll = () => {
      render();
      renderGenres();
    };

    for (const button of sortButtons) {
      button.addEventListener('click', () => {
        sort = button.dataset.sort as keyof typeof SORTS;
        for (const other of sortButtons) {
          other.setAttribute('aria-pressed', String(other === button));
        }
        hideTip();
        renderAll();
      });
    }

    countSelect?.addEventListener('change', () => {
      count = Number(countSelect.value);
      hideTip();
      renderAll();
    });

    renderAll();
  }
</script>

<style>
  .netflix { position: relative; }

  /* ---------- controls ---------- */

  /* A grid cell now, so it needs no width trickery of its own. */
  .controls {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    min-width: 0;
    padding: var(--space-md) var(--space-lg) var(--space-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .controls__note {
    font-size: 0.72rem;
    color: var(--ink-muted);
  }

  .control {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
    width: 100%;
  }

  .control__label {
    display: block;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: var(--space-2xs);
  }

  /* flex, not inline-flex: inline-flex sizes to max-content and would push past
     the column instead of wrapping the options onto a second line. */
  .segmented {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
    padding: 2px;
    background: var(--gridline);
    border-radius: var(--radius-sm);
  }

  .segmented button { flex: 1 1 auto; }

  .segmented button {
    padding: 0.4rem var(--space-sm);
    border: 0;
    border-radius: calc(var(--radius-sm) - 1px);
    background: transparent;
    color: var(--ink-secondary);
    font: inherit;
    font-size: var(--step--1);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .segmented button:hover { color: var(--ink); }
  .segmented button[aria-pressed='true'] {
    background: var(--surface-raised);
    color: var(--ink);
    font-weight: 560;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
  }

  .control--count { display: flex; flex-direction: column; }

  .control--count select {
    padding: 0.45rem var(--space-sm);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface-raised);
    color: var(--ink);
    font: inherit;
    font-size: var(--step--1);
    cursor: pointer;
  }

  /* ---------- panels ---------- */

  /* The dashboard runs wider than the rest of the page — a chart grid needs the
     room, and body copy elsewhere does not. */
  .netflix > .container { max-width: 1360px; }

  /* Single column while narrow; DOM order (filters, titles, genres, weights)
     is already the right reading order there. */
  .dashboard {
    display: grid;
    gap: var(--space-md);
    align-items: start;
  }

  @media (min-width: 60rem) {
    .dashboard {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
    /* Titles runs the full height of the left column; the right column stacks
       filters, genres, and the weighting model. */
    .panel--titles  { grid-column: 1; grid-row: 1 / span 3; }
    .controls       { grid-column: 2; grid-row: 1; }
    .panel--genres  { grid-column: 2; grid-row: 2; }
    .panel--weights { grid-column: 2; grid-row: 3; }
  }

  .panel {
    margin: 0;
    padding: var(--space-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    min-width: 0;
  }

  .panel__head { margin-bottom: var(--space-md); }

  .panel__title {
    font-size: var(--step-0);
    font-weight: 600;
    margin-bottom: var(--space-2xs);
  }

  .panel__note {
    font-size: var(--step--1);
    color: var(--ink-secondary);
    line-height: 1.45;
  }

  .panel__foot {
    margin-top: var(--space-md);
    font-size: 0.72rem;
    color: var(--ink-muted);
  }

  /* ---------- bars ---------- */

  .bars {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    counter-reset: rank;
  }

  /* Label above the bar, not beside it. Beside it, a third-width panel left the
     label ~168px — fine for "Science Fiction" but it cut most film titles in
     half, which is exactly the difference between the two panels. Stacking
     gives the label the full width and the bar the full width too. */
  .bar-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 5px;
    padding: 2px var(--space-2xs) 4px;
    border-radius: var(--radius-sm);
    cursor: default;
    transition: background 0.12s ease;
  }
  .bar-row:hover,
  .bar-row:focus-visible { background: var(--accent-wash); }

  /* Title and value share one cell so they read as "Name - 899" rather than
     sitting either side of the bar with nothing joining them. */
  .bar-row__head {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
