---
import data from '../data/netflix-ads.json';

const { titles, genres, weights, titleCount, genreCoverage, generated } = data;

const fmtHours = (n: number) =>
  n >= 1_000_000_000 ? `${(n / 1_000_000_000).toFixed(1)}B` : `${Math.round(n / 1_000_000)}M`;

// Every figure on screen is grouped — an unseparated 991500000 is unreadable.
const fmtInt = (n: number) => Math.round(n).toLocaleString('en-US');
const fmtDec = (n: number, digits = 1) =>
  n.toLocaleString('en-US', { minimumFractionDigits: digits, maximumFractionDigits: digits });

// Titles are pre-sorted by score; the client re-sorts from this same list.
const initial = titles.slice(0, 12);
const maxScore = Math.max(...titles.map((t) => t.score));
const maxGenre = Math.max(...genres.map((g) => g.avgScore));

const seriesVar = ['--series-1', '--series-2', '--series-3', '--series-4'];
---

<section class="section netflix" id="netflix">
  <div class="container">
    <p class="section__label">Live project data</p>
    <h2 class="section__title">Netflix Ad Opportunity Score</h2>
    <p class="section__intro">
      Which titles are worth buying ad inventory against? I scored all {titleCount} titles in the
      2025–26 global top 500 by blending how much they were actually watched with how long they
      stayed relevant. These charts run on the real output of that analysis — not screenshots.
    </p>

    <!--
      Filters sit above the charts, boxed to the width of a single panel. The
      outer grid mirrors the panels grid so column 1 lines up exactly; auto-fill
      rather than auto-fit, so the empty tracks hold their width instead of
      collapsing and letting the filters stretch across the whole row.
    -->
    <div class="controls">
      <div class="controls__inner">
        <fieldset class="control">
          <legend class="control__label">Rank by</legend>
          <div class="segmented" role="group">
            <button type="button" data-sort="score" aria-pressed="true">Opportunity score</button>
            <button type="button" data-sort="hoursViewed" aria-pressed="false">Hours viewed</button>
            <button type="button" data-sort="weeksInTop10" aria-pressed="false">Weeks in top 10</button>
          </div>
        </fieldset>

        <label class="control control--count">
          <span class="control__label">Show top</span>
          <select data-count>
            <option value="8">8</option>
            <option value="12" selected>12</option>
            <option value="20">20</option>
            <option value="30">30</option>
          </select>
        </label>
      </div>
    </div>

    <div class="panels">
      <!-- ---------- titles ---------- -->
      <figure class="panel">
        <figcaption class="panel__head">
          <h3 class="panel__title" data-title-heading>Top Titles by Opportunity Score</h3>
          <p class="panel__note" data-title-note>
            Score blends hours viewed, sustained ranking, rating, and recency.
          </p>
        </figcaption>

        <ol class="bars" data-titles data-max={maxScore}>
          {
            initial.map((t) => (
              <li class="bar-row">
                <span class="bar-row__head">
                  <span class="bar-row__title" title={t.title}>{t.title}</span>
                  <span class="bar-row__value">- {fmtInt(t.score)}</span>
                </span>
                <span class="bar-row__track">
                  <span class="bar-row__bar" style={`--pct:${(t.score / maxScore) * 100}%`} />
                </span>
                <span class="bar-row__meta">
                  {t.year} · {fmtInt(t.weeksInTop10)} wks · {fmtHours(t.hoursViewed)} hrs
                </span>
              </li>
            ))
          }
        </ol>

        <p class="panel__foot">
          Hover or focus a bar for the underlying numbers.
        </p>
      </figure>

      <!-- ---------- genres ---------- -->
      <figure class="panel">
        <figcaption class="panel__head">
          <h3 class="panel__title">Genres by Average Score</h3>
          <p class="panel__note">
            Averaged across every ranked title carrying that genre. Title counts vary — War is a
            small, high-performing set.
          </p>
        </figcaption>

        <ol class="bars bars--genre">
          {
            genres.slice(0, 8).map((g) => (
              <li class="bar-row">
                <span class="bar-row__head">
                  <span class="bar-row__title">{g.genre}</span>
                  <span class="bar-row__value">- {fmtDec(g.avgScore)}</span>
                </span>
                <span class="bar-row__track">
                  <span
                    class="bar-row__bar bar-row__bar--alt"
                    style={`--pct:${(g.avgScore / maxGenre) * 100}%`}
                  />
                </span>
                <span class="bar-row__meta">
                  {fmtInt(g.titleCount)} titles · {fmtHours(g.totalHours)} hrs
                </span>
              </li>
            ))
          }
        </ol>
      </figure>

      <!-- ---------- scoring model ---------- -->
      <figure class="panel">
        <figcaption class="panel__head">
          <h3 class="panel__title">How the Score Is Weighted</h3>
          <p class="panel__note">
            Hours viewed dominates deliberately — it is the closest available proxy for realised ad
            impressions. The rest adjust for staying power and quality.
          </p>
        </figcaption>

        <!-- Proportion bar. Every segment is direct-labelled below: two of these
             hues sit under 3:1 on the light surface, so labels are required relief,
             not decoration. -->
        <div class="weights" role="img" aria-label={
          weights.map((w) => `${w.component} ${w.weight} percent`).join(', ')
        }>
          {
            weights.map((w, i) => (
              <span
                class="weights__segment"
                style={`--pct:${w.weight}%; --fill:var(${seriesVar[i % seriesVar.length]})`}
              />
            ))
          }
        </div>

        <ul class="weights__key">
          {
            weights.map((w, i) => (
              <li class="weights__item">
                <span
                  class="weights__swatch"
                  style={`--fill:var(${seriesVar[i % seriesVar.length]})`}
                  aria-hidden="true"
                />
                <span class="weights__name">{w.component}</span>
                <span class="weights__pct">{w.weight}%</span>
                <span class="weights__why">{w.rationale}</span>
              </li>
            ))
          }
        </ul>
      </figure>
    </div>

    <details class="caveat">
      <summary>Data notes and known limits</summary>
      <div class="caveat__body">
        <p>
          Genre coverage is partial: only {genreCoverage.tagged} of the top {genreCoverage.total}
          titles carry genre metadata, because most 2025–26 chart-toppers are newer than the
          catalogue they join against. That is why there is no genre filter on the titles chart —
          it would silently hide two-thirds of the data. The genre panel aggregates across all
          {titleCount} ranked titles, where coverage is high enough to average meaningfully.
        </p>
        <p>
          <em>KPop Demon Hunters</em> is a genuine outlier at roughly four times the second-place
          score, which compresses everything below it. It is left in rather than trimmed, because
          the whole point of the metric is to surface exactly that kind of title.
        </p>
        <p>Data generated {generated} from the project's processed output.</p>
      </div>
    </details>

    <p class="netflix__links">
      <a href="https://github.com/gregchedwick/Netflix-Ads-Analytics">Repository</a>
      <span aria-hidden="true">·</span>
      <a href="https://github.com/gregchedwick/Netflix-Ads-Analytics/blob/main/Notebooks/01_data_exploration.ipynb">
        Analysis notebook
      </a>
      <span aria-hidden="true">·</span>
      <a href="https://github.com/gregchedwick/Netflix-Ads-Analytics/tree/main/Reports">
        Power BI report
      </a>
    </p>
  </div>

  <!-- Single tooltip element, repositioned on hover/focus. -->
  <div class="tip" data-tip hidden role="status" aria-live="polite"></div>
</section>

<script>
  import titleData from '../data/netflix-ads.json';

  type Title = (typeof titleData.titles)[number];

  const list = document.querySelector<HTMLOListElement>('[data-titles]');
  const heading = document.querySelector<HTMLElement>('[data-title-heading]');
  const note = document.querySelector<HTMLElement>('[data-title-note]');
  const countSelect = document.querySelector<HTMLSelectElement>('[data-count]');
  const sortButtons = document.querySelectorAll<HTMLButtonElement>('[data-sort]');
  const tip = document.querySelector<HTMLElement>('[data-tip]');

  if (list && tip) {
    const fmtInt = (n: number) => Math.round(n).toLocaleString('en-US');
    const fmtDec = (n: number, digits = 1) =>
      n.toLocaleString('en-US', { minimumFractionDigits: digits, maximumFractionDigits: digits });
    // Compact form, for the sub-line only — the tooltip keeps the full figure.
    const fmtHours = (n: number) =>
      n >= 1_000_000_000 ? `${(n / 1_000_000_000).toFixed(1)}B` : `${Math.round(n / 1_000_000)}M`;

    const SORTS = {
      score: {
        key: 'score' as const,
        heading: 'Top Titles by Opportunity Score',
        note: 'Score blends hours viewed, sustained ranking, rating, and recency.',
        format: (t: Title) => fmtInt(t.score),
      },
      hoursViewed: {
        key: 'hoursViewed' as const,
        heading: 'Top Titles by Hours Viewed',
        note: 'Raw consumption — the single largest input to the score, shown on its own.',
        format: (t: Title) => fmtInt(t.hoursViewed),
      },
      weeksInTop10: {
        key: 'weeksInTop10' as const,
        heading: 'Top Titles by Weeks in the Top 10',
        note: 'Staying power. Note how differently this ranks from raw hours — that gap is why the score exists.',
        format: (t: Title) => fmtInt(t.weeksInTop10),
      },
    };

    let sort: keyof typeof SORTS = 'score';
    let count = 12;

    const render = () => {
      const config = SORTS[sort];
      const rows = [...titleData.titles]
        .sort((a, b) => (b[config.key] as number) - (a[config.key] as number))
        .slice(0, count);

      const max = Math.max(...rows.map((r) => r[config.key] as number));

      if (heading) heading.textContent = config.heading;
      if (note) note.textContent = config.note;

      list.replaceChildren(
        ...rows.map((t) => {
          const li = document.createElement('li');
          li.className = 'bar-row';
          li.tabIndex = 0;
          // Header repeats the ranked value so the tooltip matches the bar the
          // pointer is on, whichever sort is active. Every metric line is
          // "Label - Value" and stays on one line; the CSS does not wrap them.
          li.dataset.tipHead = `${t.title} - ${config.format(t)}`;
          li.dataset.tip = [
            `Opportunity Score - ${fmtDec(t.score)}`,
            `Hours Viewed - ${fmtInt(t.hoursViewed)}`,
            `Weeks in Top 10 - ${fmtInt(t.weeksInTop10)}`,
            t.voteAverage ? `Rating - ${fmtDec(t.voteAverage)} / 10` : null,
            t.runtime ? `Runtime - ${fmtInt(t.runtime)} min` : null,
            // A year is an identifier, not a quantity — never group it as 2,025.
            t.year ? `Released - ${t.year}` : null,
          ]
            .filter(Boolean)
            .join('\n');

          const head = document.createElement('span');
          head.className = 'bar-row__head';

          const title = document.createElement('span');
          title.className = 'bar-row__title';
          title.textContent = t.title;
          title.title = t.title;

          const value = document.createElement('span');
          value.className = 'bar-row__value';
          value.textContent = `- ${config.format(t)}`;

          head.append(title, value);

          const track = document.createElement('span');
          track.className = 'bar-row__track';
          const bar = document.createElement('span');
          bar.className = 'bar-row__bar';
          bar.style.setProperty('--pct', `${((t[config.key] as number) / max) * 100}%`);
          track.append(bar);

          // Mirrors the genre panel's sub-line, and carries the two measures
          // that are not currently driving the ranking.
          const meta = document.createElement('span');
          meta.className = 'bar-row__meta';
          meta.textContent = [
            t.year,
            `${fmtInt(t.weeksInTop10)} wks`,
            `${fmtHours(t.hoursViewed)} hrs`,
          ].join(' · ');

          li.append(head, track, meta);
          return li;
        }),
      );
    };

    // --- tooltip ---

    const showTip = (row: HTMLElement) => {
      const text = row.dataset.tip;
      if (!text) return;

      const head = document.createElement('strong');
      head.className = 'tip__head';
      head.textContent = row.dataset.tipHead ?? '';

      const body = document.createElement('span');
      body.className = 'tip__body';
      body.textContent = text;

      tip.replaceChildren(head, body);
      tip.hidden = false;

      const rect = row.getBoundingClientRect();
      const tipRect = tip.getBoundingClientRect();
      const gap = 10;

      // Prefer above the row; flip below when there isn't room.
      const above = rect.top - tipRect.height - gap;
      const top = above > 8 ? above : rect.bottom + gap;

      // Clamp horizontally so the tip never pushes the page sideways.
      const left = Math.min(
        Math.max(gap, rect.left + rect.width / 2 - tipRect.width / 2),
        window.innerWidth - tipRect.width - gap,
      );

      tip.style.transform = `translate(${left}px, ${top}px)`;
    };

    const hideTip = () => {
      tip.hidden = true;
    };

    list.addEventListener('pointerover', (event) => {
      const row = (event.target as HTMLElement).closest<HTMLElement>('.bar-row');
      if (row) showTip(row);
    });
    list.addEventListener('pointerleave', hideTip);
    list.addEventListener('focusin', (event) => {
      const row = (event.target as HTMLElement).closest<HTMLElement>('.bar-row');
      if (row) showTip(row);
    });
    list.addEventListener('focusout', hideTip);
    window.addEventListener('scroll', hideTip, { passive: true });

    // --- controls ---

    for (const button of sortButtons) {
      button.addEventListener('click', () => {
        sort = button.dataset.sort as keyof typeof SORTS;
        for (const other of sortButtons) {
          other.setAttribute('aria-pressed', String(other === button));
        }
        hideTip();
        render();
      });
    }

    countSelect?.addEventListener('change', () => {
      count = Number(countSelect.value);
      hideTip();
      render();
    });

    render();
  }
</script>

<style>
  .netflix { position: relative; }

  /* ---------- controls ---------- */

  /* Same track sizing as .panels, so the filters occupy exactly column 1. */
  .controls {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .controls__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-sm);
    min-width: 0;
  }

  .control {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
    width: 100%;
  }

  .control__label {
    display: block;
    padding: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: var(--space-2xs);
  }

  /* flex, not inline-flex: inline-flex sizes to max-content and would push past
     the column instead of wrapping the options onto a second line. */
  .segmented {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
    padding: 2px;
    background: var(--gridline);
    border-radius: var(--radius-sm);
  }

  .segmented button { flex: 1 1 auto; }

  .segmented button {
    padding: 0.4rem var(--space-sm);
    border: 0;
    border-radius: calc(var(--radius-sm) - 1px);
    background: transparent;
    color: var(--ink-secondary);
    font: inherit;
    font-size: var(--step--1);
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .segmented button:hover { color: var(--ink); }
  .segmented button[aria-pressed='true'] {
    background: var(--surface-raised);
    color: var(--ink);
    font-weight: 560;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.08);
  }

  .control--count { display: flex; flex-direction: column; }

  .control--count select {
    padding: 0.45rem var(--space-sm);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--surface-raised);
    color: var(--ink);
    font: inherit;
    font-size: var(--step--1);
    cursor: pointer;
  }

  /* ---------- panels ---------- */

  /* Three equal columns on a wide screen, so titles / genres / weights sit in
     one row. The titles panel used to span two of them, which pushed the
     weights panel onto a second row and left most of that row empty. */
  .panels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-md);
    align-items: start;
  }

  .panel {
    margin: 0;
    padding: var(--space-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    min-width: 0;
  }

  .panel__head { margin-bottom: var(--space-md); }

  .panel__title {
    font-size: var(--step-0);
    font-weight: 600;
    margin-bottom: var(--space-2xs);
  }

  .panel__note {
    font-size: var(--step--1);
    color: var(--ink-secondary);
    line-height: 1.45;
  }

  .panel__foot {
    margin-top: var(--space-md);
    font-size: 0.72rem;
    color: var(--ink-muted);
  }

  /* ---------- bars ---------- */

  .bars {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    counter-reset: rank;
  }

  /* Label above the bar, not beside it. Beside it, a third-width panel left the
     label ~168px — fine for "Science Fiction" but it cut most film titles in
     half, which is exactly the difference between the two panels. Stacking
     gives the label the full width and the bar the full width too. */
  .bar-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 5px;
    padding: 2px var(--space-2xs) 4px;
    border-radius: var(--radius-sm);
    cursor: default;
    transition: background 0.12s ease;
  }
  .bar-row:hover,
  .bar-row:focus-visible { background: var(--accent-wash); }

  /* Title and value share one cell so they read as "Name - 899" rather than
     sitting either side of the bar with nothing joining them. */
  .bar-row__head {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    min-width: 0;
  }

  /* The title yields first; the number must never be the thing that truncates. */
  .bar-row__title {
    flex: 0 1 auto;
    min-width: 0;
    font-size: var(--step--1);
    color: var(--ink-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .bar-row__track {
    height: 10px;
    background: var(--gridline);
    border-radius: 5px;
    overflow: hidden;
  }

  .bar-row__bar {
    display: block;
    height: 100%;
    width: var(--pct);
    min-width: 3px;
    /* 4px rounded data-end, anchored flat to the baseline at the origin. */
    border-radius: 0 4px 4px 0;
    transform-origin: left center;
    animation: bar-grow 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* The genre panel's lighter fill, now used by both charts. It sits at 2.9:1
     on the light surface — legal here only because every bar carries a visible
     value label, which is the documented relief for a sub-3:1 fill. The dark
     mode step is chosen against the dark surface rather than reused, since
     --seq-350 there is 2.6:1 and would be worse, not better. */
  .bar-row__bar,
  .bar-row__bar--alt { background: var(--seq-350); }

  @media (prefers-color-scheme: dark) {
    :root:where(:not([data-theme='light'])) .bar-row__bar,
    :root:where(:not([data-theme='light'])) .bar-row__bar--alt {
      background: var(--seq-550);
    }
  }
  :root[data-theme='dark'] .bar-row__bar,
  :root[data-theme='dark'] .bar-row__bar--alt {
    background: var(--seq-550);
  }

  @keyframes bar-grow {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }

  .bar-row__value {
    flex: 0 0 auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
    white-space: nowrap;
  }

  .bar-row__meta {
    font-size: 0.68rem;
    color: var(--ink-muted);
    font-variant-numeric: tabular-nums;
  }

  /* Rows carrying a meta line need breathing room between them. */
  .bars { gap: var(--space-sm); }

  /* ---------- weights ---------- */

  .weights {
    display: flex;
    height: 14px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    margin-bottom: var(--space-md);
  }

  .weights__segment {
    width: var(--pct);
    background: var(--fill);
    /* 2px surface gap so adjacent fills never fuse into one shape. */
    box-shadow: inset -2px 0 0 var(--surface);
  }
  .weights__segment:last-child { box-shadow: none; }

  .weights__key {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .weights__item {
    display: grid;
    grid-template-columns: 10px 1fr auto;
    align-items: baseline;
    gap: var(--space-xs);
  }

  .weights__swatch {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: var(--fill);
  }

  .weights__name { font-size: var(--step--1); font-weight: 550; }

  .weights__pct {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }

  .weights__why {
    grid-column: 2 / -1;
    font-size: 0.72rem;
    color: var(--ink-muted);
    line-height: 1.4;
  }

  /* ---------- caveats & links ---------- */

  .caveat {
    margin-top: var(--space-lg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .caveat summary {
    padding: var(--space-sm) var(--space-md);
    cursor: pointer;
    font-size: var(--step--1);
    font-weight: 550;
    color: var(--ink-secondary);
  }
  .caveat summary:hover { color: var(--ink); }

  .caveat__body {
    padding: 0 var(--space-md) var(--space-md);
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    font-size: var(--step--1);
    color: var(--ink-secondary);
    max-width: var(--measure);
  }

  .netflix__links {
    margin-top: var(--space-lg);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm);
    font-size: var(--step--1);
    color: var(--border-strong);
  }

  /* ---------- tooltip ---------- */

  .tip {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    /* Sized to its content so each metric keeps its own line; only a very
       narrow viewport clamps it. */
    max-width: min(92vw, 30rem);
    padding: var(--space-xs) var(--space-sm);
    background: var(--surface-raised);
    color: var(--ink);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.14);
    font-size: 0.75rem;
    line-height: 1.45;
    pointer-events: none;
    font-variant-numeric: tabular-nums;
  }
  .tip[hidden] { display: none; }

  .tip__head {
    display: block;
    font-size: 0.8rem;
    font-weight: 620;
    padding-bottom: var(--space-2xs);
    margin-bottom: var(--space-2xs);
    border-bottom: 1px solid var(--border);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

